#!/usr/bin/env bash
# Is this box's Ikigai whole and running? The flake it was built from, the session units and
# their sockets, the greeter holding the console, the forked compositor, the scheduler, zram
# and the firewall. The system layer cannot drift on NixOS; what is left to check is what
# runs. Prints one line per check; exits 1 if any is "bad".
set -uo pipefail

FLAKE="${IKIGAI_FLAKE:-@flake@}"
STATE="${IKIGAI_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ikigai}"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
bad=0
ok()   { printf '  ok    %-12s %s\n' "$1" "$2"; }
warn() { printf '  warn  %-12s %s\n' "$1" "$2"; }
fail() { printf '  BAD   %-12s %s\n' "$1" "$2"; bad=1; }

echo "ikigai doctor"

# ---- the flake and the generation --------------------------------------------------
if [ -f "$FLAKE/flake.nix" ]; then
  if [ -d "$FLAKE/.git" ]; then
    dirty=$(git -C "$FLAKE" status --short 2>/dev/null | wc -l)
    [ "$dirty" -eq 0 ] && ok flake "$FLAKE clean" || warn flake "$FLAKE has $dirty uncommitted change(s)"
  else ok flake "$FLAKE (not a git checkout)"; fi
else warn flake "no flake at $FLAKE (ikigai-update needs one)"; fi
booted=$(readlink /run/booted-system); current=$(readlink /run/current-system)
[ "$booted" = "$current" ] && ok system "${current##*/}" || warn system "running ${current##*/}, booted ${booted##*/}: reboot for the kernel and the greeter"

# ---- session -----------------------------------------------------------------------
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  warn session "not inside a Wayland session; skipping unit checks"
else
  [ "${XDG_CURRENT_DESKTOP:-}" ] && ok desktop "XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP"
  for u in ikigai-session.target ikigai-shell ikigai-bridge ikigai-outputs ikigai-bg ikigai-settings-daemon ikigai-idle vicinae; do
    st=$(systemctl --user is-active "$u" 2>/dev/null)
    case "$st" in
      active) ok unit "$u" ;;
      inactive) if [ "$u" = ikigai-shell ] && [ -r "$RUN/ikigai/dev-shell" ]; then ok unit "$u stopped: dev shell from $(cat "$RUN/ikigai/dev-shell")"; else fail unit "$u $st"; fi ;;
      *) fail unit "$u $st ($(systemctl --user show -p Result --value "$u" 2>/dev/null))" ;;
    esac
  done
  [ -S "$RUN/ikigai-bridge.sock" ] && ok bridge "$RUN/ikigai-bridge.sock" || fail bridge "no socket at $RUN/ikigai-bridge.sock"
  n=$(qs list -a -j 2>/dev/null | jq -r '.[].config_path // empty' 2>/dev/null | grep -c 'shell/shell.qml')
  case "$n" in
    1) ok shell "one Quickshell instance: $(qs list -a -j | jq -r '.[] | select(.config_path | endswith("shell/shell.qml")) | .config_path')" ;;
    0) fail shell "no Quickshell instance running shell.qml" ;;
    *) warn shell "$n Quickshell instances running shell.qml (installed and a dev shell?)" ;;
  esac
  [ -f "$STATE/shell-theme.json" ] && ok theme "$STATE/shell-theme.json" || fail theme "no $STATE/shell-theme.json (the home module writes it; ikigai-update)"
  [ -f "$HOME/.config/ikigai/shell.json" ] && ok config "$HOME/.config/ikigai/shell.json" || warn config "no $HOME/.config/ikigai/shell.json (shell runs on defaults)"
  [ -f "$RUN/ikigai-session.log" ] && ok log "$RUN/ikigai-session.log ($(wc -l < "$RUN/ikigai-session.log") lines)"
  if busctl --user --no-pager --list 2>/dev/null | grep -q '^org.freedesktop.secrets'; then ok keyring "org.freedesktop.secrets on the session bus"
  else warn keyring "no org.freedesktop.secrets on the session bus (nothing has asked for it yet, or gnome-keyring is off)"; fi
  [ -S "$RUN/gcr/ssh" ] && ok ssh-agent "gcr-ssh-agent at $RUN/gcr/ssh${SSH_AUTH_SOCK:+, SSH_AUTH_SOCK=$SSH_AUTH_SOCK}" || warn ssh-agent "no socket at $RUN/gcr/ssh (re-login after the first switch)"
fi

# ---- system ------------------------------------------------------------------------
if systemctl cat greetd 2>/dev/null | grep -q ikigai-greeter; then ok greeter "greetd runs ikigai-greeter"; else fail greeter "greetd is not running ikigai-greeter"; fi
comp=$(readlink -f "$(command -v cosmic-comp 2>/dev/null)" 2>/dev/null)
case "$comp" in
  *ikigai*) ok comp "cosmic-comp fork: ${comp#/nix/store/}" ;;
  "") fail comp "no cosmic-comp on PATH" ;;
  *) fail comp "stock cosmic-comp (${comp#/nix/store/}); the overlay is not applied" ;;
esac
for f in @shell@/shell.qml /run/current-system/sw/share/ikigai/theme/shell.json /run/current-system/sw/share/wayland-sessions/ikigai.desktop; do
  [ -e "$f" ] && ok file "$f" || fail file "missing $f"
done
systemctl -q is-active firewall 2>/dev/null && ok firewall "active" || fail firewall "firewall.service not active"
systemctl -q is-active systemd-oomd 2>/dev/null && ok oomd "systemd-oomd active" || warn oomd "systemd-oomd not active"
if systemctl -q is-enabled scx_loader 2>/dev/null; then
  sched=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true)
  [ -n "$sched" ] && ok sched "$sched via scx_loader" || warn sched "scx_loader enabled but sched_ext is off ($(cat /sys/kernel/sched_ext/state 2>/dev/null || echo 'no sched_ext in this kernel')); EEVDF"
else warn sched "scx_loader not enabled; EEVDF"; fi
if [ -e /sys/block/zram0 ]; then
  zsize=$(swapon --show=SIZE --noheadings --bytes /dev/zram0 2>/dev/null); zused=$(swapon --show=USED --noheadings --bytes /dev/zram0 2>/dev/null)
  ram=$(( $(awk '/^MemTotal/{print $2}' /proc/meminfo) * 1024 ))
  if [ "${zsize:-0}" -lt "$ram" ]; then warn zram "zram0 $(numfmt --to=iec "${zsize:-0}") < RAM (reboot for the new size)"
  elif [ $(( zused * 100 / zsize )) -ge 90 ]; then warn zram "zram0 $(numfmt --to=iec "$zused")/$(numfmt --to=iec "$zsize") used: swap full, only file cache left to reclaim"
  else ok zram "zram0 $(numfmt --to=iec "$zsize"), $(numfmt --to=iec "$zused") used"; fi
else warn zram "no zram0 (comes up at boot)"; fi
systemctl -q is-enabled NetworkManager-wait-online 2>/dev/null && warn boot "NetworkManager-wait-online enabled" || ok boot "nothing waits on the network at boot"
[ "$(getent passwd "$USER" | cut -d: -f7)" = "$(command -v zsh)" ] && ok shell-login zsh || warn shell-login "login shell is not zsh"
id -nG | tr ' ' '\n' | grep -qx docker && ok docker "in docker group" || warn docker "not in docker group (re-login after the first switch)"
if [ -e /proc/driver/nvidia/version ]; then
  v=$(sed -n 's/.*Kernel Module  *\([0-9.]*\).*/\1/p' /proc/driver/nvidia/version | head -1)
  ok nvidia "$v"
fi
if command -v steam >/dev/null; then
  if [ ! -c /dev/ntsync ]; then warn ntsync "/dev/ntsync missing; rebuild with Steam enabled, or sudo modprobe ntsync for this boot"
  elif [ ! -r /dev/ntsync ] || [ ! -w /dev/ntsync ]; then warn ntsync "/dev/ntsync is not readable and writable in this login"
  else ok ntsync "device available; check lsof /dev/ntsync while a GE-Proton game runs to confirm use"; fi
fi
if command -v gamemoded >/dev/null; then
  if ! id -nG | tr ' ' '\n' | grep -qx gamemode; then warn gamemode "not in the gamemode group in this login: gamemoderun cannot renice until you log out and in"
  else ok gamemode "group in session"; fi
fi

exit $bad
