#!/usr/bin/env bash
# Steam, once `ikigai.steam.enable = true` in the flake has put it on the box with gamemode,
# gamescope, mangohud and the 32-bit driver: checks the gamemode group reached this login,
# pins Steam to the rail, and launches it. Proton ships with Steam: turn on Steam Play for
# all titles in Settings; Proton-GE is installed next to it.
set -euo pipefail

if ! command -v steam >/dev/null; then
  echo "Steam is not installed. In your flake: ikigai.steam.enable = true; then ikigai-update." >&2
  exit 1
fi
# gamemode renices a game to -10 for members of its group only; groups are read at login.
if ! id -nG | tr ' ' '\n' | grep -qx gamemode; then
  echo "this login is not in the gamemode group: log out and back in before gamemoderun can renice"
fi
echo "Launch options worth knowing:"
echo "  gamemoderun %command%            nice -10 and the performance governor while the game runs"
echo "  mangohud %command%               fps and hardware overlay"
echo "  gamescope -f -- %command%        nested session: forced resolution, FSR, sane fullscreen"
# Pin Steam to the rail, once. The shell watches shell.json, so this lands live.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ikigai/shell.json"
if [ -f "$cfg" ] && ! jq -e '([(.pinned.top // [])[], (.pinned.bottom // [])[]] | index("steam")) != null' "$cfg" >/dev/null; then
  tmp=$(mktemp "$cfg.XXXXXX")
  jq '.pinned.bottom = ((.pinned.bottom // []) + ["steam"])' "$cfg" > "$tmp" && mv "$tmp" "$cfg" || rm -f "$tmp"
fi
[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && setsid steam >/dev/null 2>&1 &
exit 0
