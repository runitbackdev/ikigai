# shellcheck shell=bash
# The Ikigai installer, run by the ISO or the kexec image on tty1 (nix/installer/live.nix).
# Asks for the disk, a user, a password, a hostname and a timezone, writes a personal flake
# from the answers to /etc/nixos of the new system and runs nixos-install from it. From
# boot.ps1 and ikigai-migrate the mode comes from the kernel command line; from a stick it asks.
#   ikigai.mode=replace   wipe the disk: an ESP and a root
#   ikigai.mode=dual      keep Windows: /boot and a root in the largest free region,
#                         Windows' own ESP mounted at /efi for the loader
#   ikigai.mode=migrate   an Arch Ikigai, in place: empty its root of Arch and install into
#                         it, keeping the home and the state; the facts in its
#                         /ikigai-migrate.json (ikigai-migrate wrote them), ikigai.root= names it
#   ikigai.ref=<branch>   which Ikigai to install (main)

say() { printf '\e[36m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31mikigai-install: %s\e[0m\n' "$*" >&2; exit 1; }
param() { sed -n "s/.*[[:space:]]$1=\([^[:space:]]*\).*/\1/p" /proc/cmdline; }
ask() { # ask VAR "prompt" "default"
  local v; read -r -p "$2${3:+ [$3]}: " v; printf -v "$1" '%s' "${v:-$3}";
}

choice="" disk="" hostname="" username="" timezone="" keymap="" gitname="" gitemail="" uid="" locale="" country="" steam="" efi_part="" efi_mount=""
[ "$(id -u)" = 0 ] || die "run as root"
[ -d /sys/firmware/efi ] || die "this machine booted in legacy BIOS mode; Ikigai needs UEFI"
mode="$(param ikigai.mode)"
ref="$(param ikigai.ref)"; ref="${ref:-main}"

echo
echo "  ikigai install"
echo

until curl -fsS -m 10 -o /dev/null https://github.com; do
  say "No internet. Wi-Fi: nmcli device wifi connect <network> --ask. Then press Enter."
  read -r _
done

# ---- migrate: the facts come from the Arch box ------------------------------------------
migrate_root="$(param ikigai.root)"
facts=""
if [ "$mode" = migrate ]; then
  [ -n "$migrate_root" ] || die "ikigai.mode=migrate without ikigai.root="
  udevadm settle
  root_part=$(blkid -l -o device -t "$migrate_root") || die "no partition for $migrate_root"
  mkdir -p /mnt && mount "$root_part" /mnt
  [ -f /mnt/ikigai-migrate.json ] || die "no /ikigai-migrate.json on $root_part; run ikigai-migrate on the Arch side first"
  facts=$(cat /mnt/ikigai-migrate.json)
  fact() { jq -r --arg k "$1" '.[$k] // empty' <<<"$facts"; }
  hostname=$(fact host); username=$(fact user); uid=$(fact uid); hashed=$(fact hashedPassword)
  timezone=$(fact timeZone); keymap=$(fact keyMap); locale=$(fact locale); country=$(fact wifiCountry)
  gpu=$(fact gpu); steam=$(fact steam); gitname=$(fact gitName); gitemail=$(fact gitEmail)
  boot_part=$(blkid -l -o device -t "UUID=$(fact boot)") || die "no partition for the boot UUID"
  efi_part=""; [ -n "$(fact efi)" ] && efi_part=$(blkid -l -o device -t "UUID=$(fact efi)")
  disk="/dev/$(lsblk -no pkname "$root_part")"
  say "migrating $hostname on $root_part (boot $boot_part${efi_part:+, efi $efi_part}); user $username ($uid), gpu $gpu"
  echo "  Arch goes from the root filesystem; /home and the state stay. Ctrl-C now stops it."
  read -r -p "Enter to install: " _
fi

# ---- the disk ------------------------------------------------------------------------
if [ "$mode" != migrate ] && [ -z "$mode" ]; then
  echo "  1) replace: wipe a disk"
  echo "  2) dual:    keep Windows, install into free space next to it"
  ask choice "Install mode" 1
  case "$choice" in 2|dual) mode=dual ;; *) mode=replace ;; esac
fi
stage=""
if [ "$mode" = migrate ]; then
  :
elif stage="$(readlink -f /dev/disk/by-label/IKIGAI 2>/dev/null)" && [ -b "$stage" ] && [ "$(lsblk -no TYPE "$stage")" = part ]; then
  disk="/dev/$(lsblk -no pkname "$stage")"
  say "Booted from the staging partition $stage; the disk is $disk"
else
  stage=""
  lsblk -dno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" { printf "  /dev/%-10s %8s  %s\n", $1, $2, $3 }'
  ask disk "Disk to install to (everything on it goes in replace mode)" ""
fi
[ -b "$disk" ] || die "no such disk: $disk"
if [ "$mode" = replace ]; then
  read -r -p "Type the disk name again to erase $disk: " confirm
  [ "$confirm" = "$disk" ] || [ "/dev/$confirm" = "$disk" ] || die "not confirmed"
fi

# ---- who -----------------------------------------------------------------------------
if [ "$mode" != migrate ]; then
ask hostname "Hostname" ikigai
ask username "Username" ""
[[ $username =~ ^[a-z_][a-z0-9_-]*$ ]] || die "username must be lowercase letters, digits, - and _"
while :; do
  read -r -s -p "Password: " pw1; echo
  read -r -s -p "Again: " pw2; echo
  [ -n "$pw1" ] && [ "$pw1" = "$pw2" ] && break
  echo "empty or different; again"
done
hashed=$(printf '%s' "$pw1" | mkpasswd -s -m yescrypt)
ask timezone "Timezone" "$(curl -fsS -m 5 https://ipapi.co/timezone 2>/dev/null || echo UTC)"
[ -e "/etc/zoneinfo/$timezone" ] || [ -e "/usr/share/zoneinfo/$timezone" ] || timedatectl list-timezones | grep -qx "$timezone" || die "unknown timezone $timezone"
ask keymap "Keyboard layout" us
ask gitname "Git name (blank to skip)" "$username"
ask gitemail "Git email (blank to skip)" ""

gpu=none
for vendor in /sys/class/drm/card[0-9]/device/vendor; do
  [ -r "$vendor" ] || continue
  case "$(cat "$vendor")" in
    0x10de) gpu=nvidia ;;
    0x1002) [ "$gpu" = nvidia ] || gpu=amd ;;
    0x8086) [ "$gpu" = none ] && gpu=intel ;;
  esac
done
say "gpu: $gpu  mode: $mode  disk: $disk  host: $hostname  user: $username  tz: $timezone"
read -r -p "Install? [y/N] " go; [ "$go" = y ] || [ "$go" = Y ] || die "stopped"
fi

# ---- partitions ----------------------------------------------------------------------
if [ "$mode" = migrate ]; then
  # Empty the root of Arch, keep what is the user's and the box's. /boot is the ESP or the
  # XBOOTLDR partition: Arch's kernels, initramfs and loader entries go, Windows' files stay.
  say "Removing Arch from $root_part"
  rm -f /mnt/ikigai-migrate.json
  keep_top="home root opt srv var etc nix lost+found"
  keep_var="lib"
  keep_var_lib="docker ikigai AccountsService bluetooth NetworkManager"
  keep_etc="NetworkManager machine-id ssh"
  for e in /mnt/* /mnt/.[!.]*; do
    [ -e "$e" ] || continue
    case " $keep_top " in *" $(basename "$e") "*) ;; *) rm -rf --one-file-system "$e" ;; esac
  done
  for e in /mnt/var/* /mnt/var/.[!.]*; do
    [ -e "$e" ] || continue
    case " $keep_var " in *" $(basename "$e") "*) ;; *) rm -rf --one-file-system "$e" ;; esac
  done
  for e in /mnt/var/lib/* /mnt/var/lib/.[!.]*; do
    [ -e "$e" ] || continue
    case " $keep_var_lib " in *" $(basename "$e") "*) ;; *) rm -rf --one-file-system "$e" ;; esac
  done
  for e in /mnt/etc/* /mnt/etc/.[!.]*; do
    [ -e "$e" ] || continue
    case " $keep_etc " in *" $(basename "$e") "*) ;; *) rm -rf --one-file-system "$e" ;; esac
  done
  # Only the host keys of /etc/ssh; NixOS writes the rest.
  find /mnt/etc/ssh -mindepth 1 -maxdepth 1 -not -name 'ssh_host_*' -exec rm -rf {} +
  mount --mkdir -o umask=077 "$boot_part" /mnt/boot
  for e in /mnt/boot/* /mnt/boot/.[!.]*; do
    [ -e "$e" ] || continue
    case "$(basename "$e")" in
      EFI) for f in /mnt/boot/EFI/*; do [ -e "$f" ] || continue; case "$(basename "$f")" in Microsoft|microsoft) ;; *) rm -rf "$f" ;; esac; done ;;
      *) rm -rf "$e" ;;
    esac
  done
  if [ -n "$efi_part" ]; then
    mount --mkdir -o umask=077 "$efi_part" /mnt/efi
    rm -rf /mnt/efi/loader /mnt/efi/EFI/systemd /mnt/efi/EFI/BOOT /mnt/efi/EFI/Linux
    efi_mount=/efi
  else
    efi_mount=/boot
  fi
  # Arch gave the user a private group; NixOS puts normal users in `users`.
  chown -R "$uid:users" "/mnt/home/$username" 2>/dev/null || true
elif [ "$mode" = replace ]; then
  umount -R /mnt 2>/dev/null || true
  say "Partitioning $disk: 1 GiB ESP, root on the rest"
  sgdisk --zap-all "$disk" >/dev/null
  sgdisk -n 1:0:+1GiB -t 1:ef00 -c 1:BOOT -n 2:0:0 -t 2:8300 -c 2:nixos "$disk" >/dev/null
  udevadm settle
  boot_part="$(lsblk -pnro NAME "$disk" | sed -n 2p)"; root_part="$(lsblk -pnro NAME "$disk" | sed -n 3p)"
  mkfs.vfat -F32 -n BOOT "$boot_part" >/dev/null
  mkfs.ext4 -qF -L nixos "$root_part"
  mount "$root_part" /mnt
  mount --mkdir -o umask=077 "$boot_part" /mnt/boot
  efi_mount=/boot
else
  umount -R /mnt 2>/dev/null || true
  # Keep Windows: drop the staging partition, then a 1 GiB /boot (XBOOTLDR, the kernels)
  # and the root in the largest free region. Windows' own ESP becomes /efi for the loader.
  if [ -n "$stage" ]; then
    say "Removing the staging partition $stage (the installer is in RAM)"
    sgdisk -d "$(cat "/sys/class/block/$(basename "$stage")/partition")" "$disk" >/dev/null
    udevadm settle
  fi
  read -r start end < <(sfdisk -F "$disk" | awk '$1 ~ /^[0-9]+$/ && $3 > best { best = $3; s = $1; e = $2 } END { print s, e }')
  [ -n "$start" ] || die "no free space on $disk"
  n=$(sgdisk -p "$disk" | awk '$1 ~ /^[0-9]+$/ { n = $1 } END { print n + 1 }')
  say "Partitioning the free region: 1 GiB /boot, root on the rest"
  sgdisk -n "$n:$start:+1GiB" -t "$n:ea00" -c "$n:BOOT" -n "$((n + 1)):0:$end" -t "$((n + 1)):8300" -c "$((n + 1)):nixos" "$disk" >/dev/null
  udevadm settle
  boot_part="$(lsblk -pnro NAME,PARTLABEL "$disk" | awk '$2 == "BOOT" { print $1 }' | tail -1)"
  root_part="$(lsblk -pnro NAME,PARTLABEL "$disk" | awk '$2 == "nixos" { print $1 }' | tail -1)"
  esp="$(lsblk -pnro NAME,PARTTYPE "$disk" | awk '$2 == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1 }' | head -1)"
  [ -b "$esp" ] || die "no EFI system partition on $disk to share with Windows"
  mkfs.vfat -F32 -n BOOT "$boot_part" >/dev/null
  mkfs.ext4 -qF -L nixos "$root_part"
  mount "$root_part" /mnt
  mount --mkdir -o umask=077 "$boot_part" /mnt/boot
  mount --mkdir -o umask=077 "$esp" /mnt/efi
  efi_mount=/efi
fi

# ---- the flake -----------------------------------------------------------------------
# Written from the answers, the way nixos-generate-config writes configuration.nix: the
# personal flake, one host, one user. No password in it: that is set inside the new system
# below and lives in /etc/shadow, so this directory can be pushed anywhere.
say "Writing the flake to /mnt/etc/nixos"
cfg=/mnt/etc/nixos
mkdir -p "$cfg/hosts/$hostname" "$cfg/users"
release=$(nixos-version 2>/dev/null | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p'); release=${release:-25.11}

cat > "$cfg/flake.nix" <<EOF
{
  description = "$hostname, an Ikigai box";

  inputs = {
    ikigai.url = "github:runitbackdev/ikigai/$ref";
    nixpkgs.follows = "ikigai/nixpkgs";
  };

  outputs =
    { self, ikigai, nixpkgs }:
    {
      nixosConfigurations.$hostname = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          ikigai.nixosModules.ikigai
          ./hosts/$hostname
          ./users/$username.nix
        ];
      };
    };
}
EOF

{
  cat <<EOF
# This box. What ikigai-install asked for is here; everything else is Ikigai's default and
# has an option (github:runitbackdev/ikigai, nix/ikigai/default.nix). Rebuild with
# \`ikigai-update\`, or \`sudo nixos-rebuild switch --flake /etc/nixos\`.
{ ... }:
{
  imports = [ ./hardware.nix ];

  ikigai = {
    enable = true;
    user = "$username";
    gpu = "$gpu";
EOF
  [ -n "$country" ] && echo "    wifiCountry = \"$country\";"
  cat <<EOF
    steam.enable = ${steam:-false};
  };

  networking.hostName = "$hostname";
  time.timeZone = "$timezone";
  i18n.defaultLocale = "${locale:-en_US.UTF-8}";
  console.keyMap = "$keymap";

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
EOF
  if [ "$efi_mount" = /efi ]; then
    echo '  # Windows'"'"' ESP holds the loader; the kernels live on their own /boot (XBOOTLDR).'
    echo '  boot.loader.efi.efiSysMountPoint = "/efi";'
    echo '  boot.loader.systemd-boot.xbootldrMountPoint = "/boot";'
  fi
  cat <<EOF

  # The NixOS release this box was first installed with. Never change it.
  system.stateVersion = "$release";
}
EOF
} > "$cfg/hosts/$hostname/default.nix"

{
  cat <<EOF
# $username. The Ikigai home module already holds every app config; this is what is only
# true here: who you are to git, how your home is laid out, what else you want installed.
# Your password is not here: \`passwd\` changes it, /etc/shadow keeps it.
{ pkgs, ... }:
{
  users.users.$username = {
    description = "$username";
EOF
  [ "$mode" = migrate ] && echo "    # The uid from the Arch box, so the home directory stays yours." && echo "    uid = $uid;"
  cat <<EOF
  };

  home-manager.users.$username =
    { config, lib, ... }:
    {
EOF
  if [ -n "$gitname" ] || [ -n "$gitemail" ]; then
    cat <<EOF
      programs.git.settings.user = {
        name = "$gitname";
        email = "$gitemail";
      };

EOF
  fi
  cat <<'EOF'
      # A home layout, for instance PARA numbered 0 Areas, 1 Projects, 2 Resources, 3 Archive:
      # Documents and the file manager's projects entry point into it, the folders are made
      # at switch, nothing inside them is ever touched.
      # xdg.userDirs = {
      #   documents = "${config.home.homeDirectory}/PARA/2";
      #   extraConfig.XDG_PROJECTS_DIR = "${config.home.homeDirectory}/PARA/1";
      # };
      # home.activation.para = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      #   run mkdir -p ~/PARA/0 ~/PARA/1 ~/PARA/2 ~/PARA/3
      # '';

      # Anything else: search.nixos.org has the names.
      home.packages = with pkgs; [
EOF
  [ "$mode" = migrate ] && echo "        # arch-packages.txt lists what pacman had; codex, for one, is in nixpkgs"
  cat <<'EOF'
      ];
    };
}
EOF
} > "$cfg/users/$username.nix"

if [ "$mode" = migrate ]; then
  # What pacman had installed on request: a checklist, since each is a line in nixpkgs now
  # (search.nixos.org) or already in $HOME (npm, cargo, pipx, uv, ~/.local/bin survive).
  {
    echo "# Packages pacman had installed on request on the Arch box, $(date -I)."
    echo "# Ikigai itself covers most; anything else is a line in users/$username.nix:"
    echo "#   home.packages = with pkgs; [ codex ];"
    echo "# Tools installed into your home (npm -g, cargo, pipx, uv, ~/.local/bin) are still there."
    jq -r '.packages[]' <<<"$facts"
  } > "$cfg/arch-packages.txt"
fi
{
  echo "# Written by nixos-generate-config at install: the disks, the kernel modules the hardware"
  echo "# needs, the CPU's microcode. Regenerate with nixos-generate-config --show-hardware-config."
  nixos-generate-config --root /mnt --show-hardware-config
} > "$cfg/hosts/$hostname/hardware.nix"
git -C "$cfg" init -q && git -C "$cfg" add -A && git -C "$cfg" -c user.name=ikigai-install -c user.email=install@ikigai commit -qm "ikigai-install: $hostname" 2>/dev/null || true

# ---- install -------------------------------------------------------------------------
say "nixos-install: the compositor, the shell and the dev stack from the cache, then the boot loader on $efi_mount"
nixos-install --root /mnt --flake "$cfg#$hostname" --no-root-passwd --no-channel-copy
# The password, into the new system's /etc/shadow, never into the flake. Root stays locked;
# sudo is the wheel group's.
say "Setting $username's password"
nixos-enter --root /mnt -c "printf '%s:%s\n' '$username' '$hashed' | chpasswd -e"
uid=$(grep "^$username:" /mnt/etc/passwd | cut -d: -f3 || echo 1000)
chown -R "${uid:-1000}:users" "$cfg"

# The one-shot entry boot.ps1 registered points at a partition that no longer exists.
efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-F]*\)\* Ikigai installer.*/\1/p' | xargs -rI{} efibootmgr -q -b {} -B || true

lsblk -o name,size,fstype,label,mountpoints "$disk"
say "Done. Your flake is /etc/nixos on the new system; ikigai-update rebuilds from it. 'reboot' when ready."
