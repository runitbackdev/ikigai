 } NVSurface;
 
 typedef enum
@@ -140,6 +141,7 @@
     CUdeviceptr externalDevicePtr;
     uint32_t    externalDeviceSize;
     uint64_t    detachedSerial;
+    bool        exported;
 } BackingImage;
 
