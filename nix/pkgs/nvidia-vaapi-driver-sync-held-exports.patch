Resolve in vaEndPicture for clients that hold an exported surface without syncing it.

vaEndPicture returns once the picture is queued; the resolve thread copies the decoded
frame into the surface's backing image afterwards. Chromium exports each surface once,
keeps the dma-buf, and samples it after vaEndPicture with no vaSyncSurface and no new
export (measured in Discord, Electron 42: 8 vaSyncSurface calls for 2280 pictures).
NVIDIA has no implicit sync and the export carries no fence, so the read races the copy
and the client can show what the buffer held the last time it was used: a steady 60 fps
decode that judders on screen.

diff -ru a/src/vabackend.c b/src/vabackend.c
--- a/src/vabackend.c
+++ b/src/vabackend.c
@@ -3037,6 +3037,21 @@
         setSurfaceResolving(nvCtx->renderTarget, false);
     }
 
+    // A client that exports a surface once and keeps the dma-buf (Chromium) reads it as
+    // soon as we return, and nothing orders that read after the resolve thread's copy:
+    // NVIDIA has no implicit sync and the export carries no fence, so it can show what
+    // the buffer held the last time round. Such a client shows itself by decoding into
+    // an exported surface it never synced or re-exported after the previous picture;
+    // from then on its pictures are resolved before vaEndPicture returns. One that
+    // syncs or exports every picture (FFmpeg, Firefox) waits there as before.
+    BackingImage *exportedImg = surface->backingImage;
+    bool heldExport = exportedImg != NULL && exportedImg->exported;
+    if (heldExport && !surface->syncedSinceDecode && !drv->clientSkipsSync) {
+        drv->clientSkipsSync = true;
+        LOG("Client reuses exported surfaces without syncing them, resolving in vaEndPicture");
+    }
+    surface->syncedSinceDecode = false;
+
     surface->context = nvCtx;
     surface->topFieldFirst = !picParams->bottom_field_flag;
     surface->secondField = picParams->second_field;
@@ -3053,6 +3068,10 @@
     //Wake up the resolve thread
     pthread_cond_signal(&nvCtx->resolveCondition);
 
+    if (heldExport && drv->clientSkipsSync) {
+        waitSurfaceResolved(surface);
+    }
+
     return status;
 }
 
@@ -3070,6 +3089,7 @@
 
     //LOG("Syncing on surface: %d (%p)", surface->pictureIdx, surface);
 
+    surface->syncedSinceDecode = true;
     waitSurfaceResolved(surface);
 
     //LOG("Surface %d resolved (%p)", surface->pictureIdx, surface);
@@ -3826,6 +3846,7 @@
 
     //LOG("Exporting surface: %d (%p)", surface->pictureIdx, surface);
 
+    surface->syncedSinceDecode = true;
     waitSurfaceResolved(surface);
 
     CHECK_CUDA_RESULT_RETURN(cu->cuCtxPushCurrent(drv->cudaContext), VA_STATUS_ERROR_OPERATION_FAILED);
@@ -3839,6 +3860,7 @@
     VADRMPRIMESurfaceDescriptor *ptr = (VADRMPRIMESurfaceDescriptor*) descriptor;
 
     drv->backend->fillExportDescriptor(drv, surface, ptr);
+    surface->backingImage->exported = true;
 
     // LOG("Exporting with w:%d h:%d o:%d p:%d m:%" PRIx64 " o:%d p:%d m:%" PRIx64, ptr->width, ptr->height, ptr->layers[0].offset[0],
     //                                                             ptr->layers[0].pitch[0], ptr->objects[0].drm_format_modifier,
